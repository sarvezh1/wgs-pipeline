nextflow.enable.dsl = 2

manifest {
    name = 'wgs-pipeline'
    version = '1.0.0-rc1'
}

params {
    analysis_type = null
    caller        = null
    input         = null
    resource_mode = 'fixture'
    resource_dir  = null
    assembly      = 'GRCh38'
    reference     = null
    reference_fai = null
    reference_dict = null
    bwa_index     = null
    resource_manifest = null
    outdir        = null
    calling_interval = null
    run_bqsr      = false
    run_vep       = false
    run_vcf2circos = false
    vcf2circos_mode = 'regional'
    vcf2circos_bin_size = 1000000
    run_multiqc   = false
    vep_mode      = 'cache'
    vep_cache     = null
    vep_gtf       = null
    vcf2circos_static = null
    known_sites   = null
    bqsr_interval = 'auto'
    gatk_germline_mode = 'vcf'
    gatk_somatic_profile = 'basic'
    mutect2_germline_resource = null
    mutect2_pon = null
    mutect2_contamination_sites = null
    run_benchmark = false
    benchmark_mode = 'regression'
    benchmark_truth = null
    benchmark_truth_index = null
    benchmark_regions = null
    benchmark_assembly = null
    benchmark_name = null
    benchmark_version = null
    benchmark_sex = 'auto'
    benchmark_stratifications = null
    run_performance_report = false
    run_analysis_report = false
    run_sv = false
    run_cnv = false
    run_coverage_qc = false
    coverage_thresholds = '10,20,30'
    ploidy_config = null
    cnv_intervals = null
    cnv_ploidy_model = null
    cnv_germline_model = null
    cnv_read_count_pon = null
    cnv_common_sites = null

    // Configurable initial HPC requests; these are not empirically optimized WGS requirements.
    hpc_queue_size = 50
    hpc_low_cpus = 1
    hpc_low_memory = '4 GB'
    hpc_low_time = '4h'
    hpc_medium_cpus = 4
    hpc_medium_memory = '16 GB'
    hpc_medium_time = '24h'
    hpc_high_cpus = 8
    hpc_high_memory = '48 GB'
    hpc_high_time = '72h'
}

process {
    errorStrategy = 'terminate'
}

trace {
    enabled = params.run_performance_report?.toString()?.toBoolean() ?: false
    file = "${params.outdir ?: 'results'}/performance/nextflow/trace.txt"
    overwrite = true
    sep = '\t'
    fields = 'task_id,hash,native_id,name,tag,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,memory,cpus,container,attempt,workdir'
}

report {
    enabled = params.run_performance_report?.toString()?.toBoolean() ?: false
    file = "${params.outdir ?: 'results'}/performance/nextflow/report.html"
    overwrite = true
}

timeline {
    enabled = params.run_performance_report?.toString()?.toBoolean() ?: false
    file = "${params.outdir ?: 'results'}/performance/nextflow/timeline.html"
    overwrite = true
}

dag {
    enabled = params.run_performance_report?.toString()?.toBoolean() ?: false
    file = "${params.outdir ?: 'results'}/performance/nextflow/dag.html"
    overwrite = true
}

profiles {
    standard {
        includeConfig 'conf/resources_local.config'
        process.executor = 'local'
        params.performance_executor = 'local'
        params.performance_container_engine = 'none'
    }

    docker {
        includeConfig 'conf/resources_local.config'
        process.executor = 'local'
        docker.enabled = true
        params.performance_executor = 'local'
        params.performance_container_engine = 'docker'
    }

    slurm {
        includeConfig 'conf/resources_hpc.config'
        process.executor = 'slurm'
        docker.enabled = false
        apptainer.enabled = true
        singularity.enabled = false
        params.performance_executor = 'slurm'
        params.performance_container_engine = 'apptainer'
    }

    slurm_singularity {
        includeConfig 'conf/resources_hpc.config'
        process.executor = 'slurm'
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
        params.performance_executor = 'slurm'
        params.performance_container_engine = 'singularity'
    }
}
