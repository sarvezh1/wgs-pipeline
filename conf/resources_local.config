// Compact-fixture/laptop requests retained exactly for regression validation.
process {
    maxForks = 1

    withName: /STRATIFIED_EXACT_BENCHMARK|STRATIFIED_GERMLINE_COMPARISON|STRATIFIED_SOMATIC_COMPARISON|STRELKA2_REGIONS|MANTA_REGIONS|SV_SUMMARY|COVERAGE_SUMMARY|CNV_SUMMARY|VCF_PROCESSING|VCF2CIRCOS_PREP/ {
        cpus = 1
        memory = '512 MB'
    }

    withName: /FASTQC|FIXTURE_REFERENCE_PREP|BWA_MEM2_ALIGN|SAMTOOLS_SORT_INDEX|SAMTOOLS_MARKDUP_QC|GATK_BQSR|SAMTOOLS_BQSR_INDEX|GATK_HAPLOTYPECALLER|GATK_HAPLOTYPECALLER_GVCF|GATK_GENOTYPE_GVCF|MUTECT2|MUTECT2_PRODUCTION|LEARN_READ_ORIENTATION_MODEL|GET_PILEUP_SUMMARIES|CALCULATE_CONTAMINATION|FILTERMUTECTCALLS|FILTERMUTECTCALLS_PRODUCTION|EXACT_ALLELE_BENCHMARK|CALLSET_COMPARISON|STRELKA2|MERGE_STRELKA2_VCFS|MOSDEPTH|VEP|VCF2CIRCOS|MULTIQC/ {
        cpus = 1
        memory = '1 GB'
    }

    withName: FASTP {
        cpus = 1
        memory = '2 GB'
    }

    withName: /FIXTURE_BWA_INDEX|DEEPVARIANT|HAPPY_BENCHMARK|DEEPSOMATIC|MANTA_GERMLINE|MANTA_SOMATIC|CNV_COLLECT_READ_COUNTS|GERMLINE_CONTIG_PLOIDY_CASE|GERMLINE_CNV_CALLER_CASE|POSTPROCESS_GERMLINE_CNV|SOMATIC_CNV_DENOISE|CNV_COLLECT_ALLELIC_COUNTS|SOMATIC_CNV_MODEL_SEGMENTS|SOMATIC_CNV_CALL_SEGMENTS/ {
        cpus = 1
        memory = '2.5 GB'
    }

    // Keep the container within the 3.7 GiB validation host; pyflow receives its separate 4 GiB bookkeeping allowance.
    withName: /MANTA_GERMLINE|MANTA_SOMATIC/ {
        cpus = 1
        memory = '3.5 GB'
    }
}

executor.queueSize = 1
