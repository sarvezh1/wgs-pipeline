// Initial, externally overridable requests for production-scale scheduling.
// They are structural defaults, not measured or recommended whole-genome requirements.
process {
    withLabel: process_low {
        cpus = params.hpc_low_cpus
        memory = params.hpc_low_memory
        time = params.hpc_low_time
    }

    withLabel: process_medium {
        cpus = params.hpc_medium_cpus
        memory = params.hpc_medium_memory
        time = params.hpc_medium_time
    }

    withLabel: process_high {
        cpus = params.hpc_high_cpus
        memory = params.hpc_high_memory
        time = params.hpc_high_time
    }
}

executor.queueSize = params.hpc_queue_size
